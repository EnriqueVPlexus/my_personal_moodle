# Copy to `.env.docker` and edit (cp .env.docker.example .env.docker).
# Used by docker-compose.yml via `docker compose --env-file .env.docker ...`.
# Never commit the real file.
#
# Every `change-me*` value must be replaced. Generate random secrets with:
#   openssl rand -hex 32
# In production the app REFUSES to work with a `change-me*` AUTH_PASSWORD_PEPPER
# or AUTH_SETUP_TOKEN (the logs name the variable to change).

# Image version to run (see Releases / GHCR tags). `latest` = newest release.
CANTERA_VERSION=latest

# Host port exposed by the app.
APP_PORT=3000

# --- Postgres (local container) ---
POSTGRES_USER=cantera
# The db container is not published to the host, so this password only protects
# the internal compose network; still, change it (and keep DATABASE_URL in sync).
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=cantera

# Must match the three values above. Host `db` is the compose service.
DATABASE_URL=postgresql://cantera:change-me-db-password@db:5432/cantera
# The local Postgres container does not speak SSL.
DATABASE_SSL=false

# --- Auth ---
# Plain http://localhost cannot use Secure cookies: keep false for local use,
# remove it (or set true) if you put the app behind HTTPS.
COOKIE_SECURE=false
# Required in production to create the first admin from /setup.
AUTH_SETUP_TOKEN=change-me-setup-token
# Optional alternative: create/promote the admin at startup instead of /setup.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password
# Extra secret mixed into password hashes. Do not change it after users exist.
AUTH_PASSWORD_PEPPER=change-me-random-pepper

# --- Optional ---
# ALLOWED_ORIGIN=http://localhost:3000
# REQUIRE_AUTH_FOR_READS=true
