# Optional bootstrap admin. Used by lib/db.ts on startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production: without it, /setup refuses to create the first
# admin account (fails closed by design, see lib/auth.ts validateSetupToken).
# In non-production environments it's optional.
AUTH_SETUP_TOKEN=

# Optional password pepper. Keep stable once users exist; rotating it locks
# out existing users until they reset their password.
AUTH_PASSWORD_PEPPER=

# Optional PostgreSQL backend. Leave empty to use local SQLite.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=

# Set to true/1/yes to require login for read endpoints.
REQUIRE_AUTH_FOR_READS=false

# Recommended in production behind a proxy/CDN: comma-separated list of
# hosts allowed to make write requests (POST/PUT/PATCH/DELETE), e.g.
# ALLOWED_ORIGIN=app.example.com,admin.example.com
# When unset, falls back to comparing the Origin header against
# x-forwarded-host/Host (fine for local dev, weaker if a proxy doesn't
# overwrite those headers before they reach this process).
ALLOWED_ORIGIN=

# Public branding.
NEXT_PUBLIC_PRODUCT_NAME=Plexus Academy
NEXT_PUBLIC_COMPANY_NAME=Plexus Tech
NEXT_PUBLIC_COMPANY_LOGO=/brand/company-logo.png
